-- ============================================
-- UTILITIES
-- ============================================
local function Create(instanceType, properties)
    local instance = Instance.new(instanceType)
    for prop, value in pairs(properties or {}) do
        instance[prop] = value
    end
    return instance
end

local function Tween(instance, properties, duration, easingStyle, easingDirection, delayTime)
    local tweenInfo = TweenInfo.new(
        duration or 0.3,
        easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out,
        0, false, delayTime or 0
    )
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

local function MakeDraggable(frame, dragHandle)
    local dragging = false
    local dragInput, dragStart, startPos

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- ============================================
-- DIAGONAL SLICE ANIMATION (Alternating Up/Down)
-- ============================================
local function DiagonalSliceAnimation(parent, direction, onComplete)
    local sliceCount = 12
    local slices = {}
    local parentSize = parent.AbsoluteSize
    local sliceWidth = math.ceil(parentSize.X / sliceCount) + 2

    local CoverFrame = Create("Frame", {
        Name = "AnimationCover",
        Parent = parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        ZIndex = 1000,
        ClipsDescendants = true,
    })

    for i = 1, sliceCount do
        local isEven = i % 2 == 0

        local slice = Create("Frame", {
            Name = "Slice" .. i,
            Parent = CoverFrame,
            BackgroundColor3 = Colors.Background,
            BorderSizePixel = 0,
            Size = UDim2.new(0, sliceWidth, 1, 0),
            Position = UDim2.new(0, (i - 1) * sliceWidth, 0, 0),
            ZIndex = 1000,
        })

        table.insert(slices, {Frame = slice, IsEven = isEven, Index = i})
    end

    if direction == "in" then
        -- OPENING: Slices slide AWAY to reveal UI underneath
        -- Odd slices: slide UP and LEFT (negative Y, negative X offset)
        -- Even slices: slide DOWN and RIGHT (positive Y, positive X offset)
        for _, sliceData in ipairs(slices) do
            local slice = sliceData.Frame
            local isEven = sliceData.IsEven
            local index = sliceData.Index

            -- Alternating diagonal directions
            local endOffsetX = isEven and 100 or -100
            local endOffsetY = isEven and (parentSize.Y + 80) or -(parentSize.Y + 80)

            local delayTime = (index - 1) * 0.08

            Tween(slice, {
                Position = UDim2.new(0, slice.Position.X.Offset + endOffsetX, 0, endOffsetY),
                BackgroundTransparency = 1,
            }, 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In, delayTime)
        end

        task.delay(1.5, function()
            CoverFrame:Destroy()
            if onComplete then onComplete() end
        end)

    else
        -- CLOSING: Slices slide IN to cover the UI
        for _, sliceData in ipairs(slices) do
            local slice = sliceData.Frame
            local isEven = sliceData.IsEven
            local index = sliceData.Index

            -- Start from opposite diagonal directions
            local startOffsetX = isEven and 100 or -100
            local startOffsetY = isEven and (parentSize.Y + 80) or -(parentSize.Y + 80)

            slice.Position = UDim2.new(0, slice.Position.X.Offset + startOffsetX, 0, startOffsetY)
            slice.BackgroundTransparency = 1

            local delayTime = (index - 1) * 0.08

            Tween(slice, {
                Position = UDim2.new(0, (index - 1) * sliceWidth, 0, 0),
                BackgroundTransparency = 0,
            }, 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, delayTime)
        end

        task.delay(1.5, function()
            if onComplete then onComplete() end
        end)
    end

    return CoverFrame
end

