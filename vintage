-- ADD TOGGLE (with text color animation)
-- ============================================
function VintageUI:AddToggle(tab, config)
    config = config or {}
    local text = config.Text or "Toggle"
    local default = config.Default or false
    local callback = config.Callback or function() end

    local ToggleFrame = Create("Frame", {
        Name = text .. "Toggle", Parent = tab.Content,
        BackgroundColor3 = Colors.ElementBg, BorderSizePixel = 0, Size = UDim2.new(1, -4, 0, 28),
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = ToggleFrame})

    local ToggleIcon = Create("Frame", {Name = "Icon", Parent = ToggleFrame, BackgroundColor3 = Colors.ElementText, BorderSizePixel = 0, Size = UDim2.new(0, 7, 0, 7), Position = UDim2.new(0, 8, 0.5, -3)})
    Create("UICorner", {CornerRadius = UDim.new(0, 1), Parent = ToggleIcon})

    local ToggleLabel = Create("TextLabel", {
        Name = "Label", Parent = ToggleFrame, BackgroundTransparency = 1,
        Text = text, TextColor3 = Colors.ElementText, TextSize = 11,
        Font = Enum.Font.Gotham, Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.new(0, 18, 0, 0), TextXAlignment = Enum.TextXAlignment.Left,
    })

    local StatusText = Create("TextLabel", {
        Name = "Status", Parent = ToggleFrame, BackgroundTransparency = 1,
        Text = default and "ON" or "OFF",
        TextColor3 = default and Colors.ToggleOn or Colors.ToggleOff,
        TextSize = 11, Font = Enum.Font.GothamBold,
        Size = UDim2.new(0, 30, 1, 0), Position = UDim2.new(1, -38, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local ClickArea = Create("TextButton", {
        Name = "ClickArea", Parent = ToggleFrame, BackgroundTransparency = 1,
        Text = "", Size = UDim2.new(1, 0, 1, 0), AutoButtonColor = false,
    })

    local enabled = default

    local function UpdateToggle()
        enabled = not enabled
        if enabled then
            Tween(StatusText, {TextColor3 = Colors.ToggleOn}, 0.25)
            StatusText.Text = "ON"
        else
            Tween(StatusText, {TextColor3 = Colors.ToggleOff}, 0.25)
            StatusText.Text = "OFF"
        end
        callback(enabled)
    end

    local isToggleHovered = false
    ClickArea.MouseEnter:Connect(function()
        isToggleHovered = true
        Tween(ToggleFrame, {BackgroundColor3 = Colors.ElementHover}, 0.15)
    end)

    ClickArea.MouseLeave:Connect(function()
        isToggleHovered = false
        Tween(ToggleFrame, {BackgroundColor3 = Colors.ElementBg}, 0.15)
    end)

    ClickArea.MouseButton1Down:Connect(function()
        Tween(ToggleFrame, {BackgroundColor3 = Colors.ElementClick}, 0.08)
    end)

    ClickArea.MouseButton1Up:Connect(function()
        Tween(ToggleFrame, {BackgroundColor3 = isToggleHovered and Colors.ElementHover or Colors.ElementBg}, 0.1)
    end)

    ClickArea.MouseButton1Click:Connect(UpdateToggle)

    return ToggleFrame
end

