-- ============================================
-- ADD KEYBIND
-- ============================================
function VintageUI:AddKeybind(tab, config)
    config = config or {}
    local text = config.Text or "Keybind"
    local default = config.Default or Enum.KeyCode.E
    local callback = config.Callback or function() end

    local KeybindFrame = Create("Frame", {Name = text .. "Keybind", Parent = tab.Content, BackgroundColor3 = Colors.ElementBg, BorderSizePixel = 0, Size = UDim2.new(1, -4, 0, 28)})
    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = KeybindFrame})

    local KeybindIcon = Create("Frame", {Name = "Icon", Parent = KeybindFrame, BackgroundColor3 = Colors.ElementText, BorderSizePixel = 0, Size = UDim2.new(0, 7, 0, 7), Position = UDim2.new(0, 8, 0.5, -3)})
    Create("UICorner", {CornerRadius = UDim.new(0, 1), Parent = KeybindIcon})

    Create("TextLabel", {Name = "Label", Parent = KeybindFrame, BackgroundTransparency = 1, Text = text, TextColor3 = Colors.ElementText, TextSize = 11, Font = Enum.Font.Gotham, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0, 18, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})

    local KeyDisplay = Create("TextLabel", {Name = "Key", Parent = KeybindFrame, BackgroundColor3 = Colors.SliderTrack, BorderSizePixel = 0, Text = default.Name, TextColor3 = Colors.ElementText, TextSize = 10, Font = Enum.Font.GothamBold, Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(1, -58, 0.5, -10), TextXAlignment = Enum.TextXAlignment.Center})
    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = KeyDisplay})

    local ClickArea = Create("TextButton", {Name = "ClickArea", Parent = KeybindFrame, BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 1, 0), AutoButtonColor = false})

    local listening = false
    ClickArea.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        KeyDisplay.Text = "..."
        Tween(KeyDisplay, {BackgroundColor3 = Colors.SliderFill}, 0.2)

        local connection
        connection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                KeyDisplay.Text = input.KeyCode.Name
                Tween(KeyDisplay, {BackgroundColor3 = Colors.SliderTrack}, 0.2)
                callback(input.KeyCode)
                listening = false
                connection:Disconnect()
            end
        end)
    end)

    ClickArea.MouseEnter:Connect(function() Tween(KeybindFrame, {BackgroundColor3 = Colors.ElementHover}, 0.15) end)
    ClickArea.MouseLeave:Connect(function() Tween(KeybindFrame, {BackgroundColor3 = Colors.ElementBg}, 0.15) end)

    return KeybindFrame
end

return VintageUI
