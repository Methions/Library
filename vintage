-- ============================================
function VintageUI:Notify(config)
    config = config or {}
    local text = config.Text or "Notification"
    local duration = config.Duration or 3

    local NotifFrame = Create("Frame", {
        Name = "Notification", Parent = self.ScreenGui,
        BackgroundColor3 = Colors.Background, BorderSizePixel = 0,
        Size = UDim2.new(0, 260, 0, 36), Position = UDim2.new(0, -280, 1, -50),
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = NotifFrame})
    Create("UIStroke", {Color = Colors.Border, Thickness = 1, Parent = NotifFrame})

    Create("TextLabel", {
        Name = "Text", Parent = NotifFrame, BackgroundTransparency = 1,
        Text = text, TextColor3 = Colors.ElementText, TextSize = 11,
        Font = Enum.Font.Gotham, Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.new(0, 6, 0, 0), TextXAlignment = Enum.TextXAlignment.Left,
    })

    Tween(NotifFrame, {Position = UDim2.new(0, 10, 1, -50)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    task.delay(duration, function()
        Tween(NotifFrame, {Position = UDim2.new(0, -280, 1, -50)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.delay(0.6, function() NotifFrame:Destroy() end)
    end)
end

-- ============================================
-- ADD DROPDOWN
-- ============================================
function VintageUI:AddDropdown(tab, config)
    config = config or {}
    local text = config.Text or "Dropdown"
    local options = config.Options or {}
    local default = config.Default or (options[1] or "")
    local callback = config.Callback or function() end

    local DropdownFrame = Create("Frame", {
        Name = text .. "Dropdown", Parent = tab.Content,
        BackgroundColor3 = Colors.ElementBg, BorderSizePixel = 0,
        Size = UDim2.new(1, -4, 0, 28), ClipsDescendants = true,
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = DropdownFrame})

    local DropdownIcon = Create("Frame", {Name = "Icon", Parent = DropdownFrame, BackgroundColor3 = Colors.ElementText, BorderSizePixel = 0, Size = UDim2.new(0, 7, 0, 7), Position = UDim2.new(0, 8, 0, 10)})
    Create("UICorner", {CornerRadius = UDim.new(0, 1), Parent = DropdownIcon})

    Create("TextLabel", {Name = "Label", Parent = DropdownFrame, BackgroundTransparency = 1, Text = text, TextColor3 = Colors.ElementText, TextSize = 11, Font = Enum.Font.Gotham, Size = UDim2.new(0.4, 0, 0, 28), Position = UDim2.new(0, 18, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})

    local SelectedText = Create("TextLabel", {Name = "Selected", Parent = DropdownFrame, BackgroundTransparency = 1, Text = default, TextColor3 = Colors.ElementText, TextSize = 11, Font = Enum.Font.GothamBold, Size = UDim2.new(0.4, 0, 0, 28), Position = UDim2.new(0.5, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right})

    local Arrow = Create("TextLabel", {Name = "Arrow", Parent = DropdownFrame, BackgroundTransparency = 1, Text = "▼", TextColor3 = Colors.ElementText, TextSize = 10, Font = Enum.Font.Gotham, Size = UDim2.new(0, 20, 0, 28), Position = UDim2.new(1, -24, 0, 0), TextXAlignment = Enum.TextXAlignment.Center})

    local OptionsFrame = Create("Frame", {Name = "Options", Parent = DropdownFrame, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 28)})
    Create("UIListLayout", {Parent = OptionsFrame, Padding = UDim.new(0, 1), SortOrder = Enum.SortOrder.LayoutOrder})

    local isOpen = false

    for _, option in ipairs(options) do
        local OptionBtn = Create("TextButton", {Name = option, Parent = OptionsFrame, BackgroundColor3 = Colors.ElementHover, BorderSizePixel = 0, Text = option, TextColor3 = Colors.ElementText, TextSize = 11, Font = Enum.Font.Gotham, Size = UDim2.new(1, 0, 0, 24), AutoButtonColor = false})

        OptionBtn.MouseEnter:Connect(function() Tween(OptionBtn, {BackgroundColor3 = Colors.ElementClick}, 0.1) end)
        OptionBtn.MouseLeave:Connect(function() Tween(OptionBtn, {BackgroundColor3 = Colors.ElementHover}, 0.1) end)
        OptionBtn.MouseButton1Click:Connect(function()
            SelectedText.Text = option
            callback(option)
            isOpen = false
            Tween(DropdownFrame, {Size = UDim2.new(1, -4, 0, 28)}, 0.2)
            Tween(Arrow, {Rotation = 0}, 0.2)
        end)
    end

    local ClickArea = Create("TextButton", {Name = "ClickArea", Parent = DropdownFrame, BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 0, 28), AutoButtonColor = false})

    ClickArea.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            Tween(DropdownFrame, {Size = UDim2.new(1, -4, 0, 28 + (#options * 25))}, 0.2)
            Tween(Arrow, {Rotation = 180}, 0.2)
        else
            Tween(DropdownFrame, {Size = UDim2.new(1, -4, 0, 28)}, 0.2)
            Tween(Arrow, {Rotation = 0}, 0.2)
        end
    end)

    ClickArea.MouseEnter:Connect(function() Tween(DropdownFrame, {BackgroundColor3 = Colors.ElementHover}, 0.15) end)
    ClickArea.MouseLeave:Connect(function() Tween(DropdownFrame, {BackgroundColor3 = Colors.ElementBg}, 0.15) end)

    return DropdownFrame
end

