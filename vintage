        if enabled then
            Tween(StatusText, {TextColor3 = Colors.ElementText}, 0.2)
            StatusText.Text = "ON"
        else
            Tween(StatusText, {TextColor3 = Colors.ToggleOff}, 0.2)
            StatusText.Text = "OFF"
        end

        callback(enabled)
    end

    ClickArea.MouseEnter:Connect(function()
        Tween(ToggleFrame, {BackgroundColor3 = Colors.ElementHover}, 0.15)
    end)

    ClickArea.MouseLeave:Connect(function()
        Tween(ToggleFrame, {BackgroundColor3 = Colors.ElementBg}, 0.15)
    end)

    ClickArea.MouseButton1Click:Connect(UpdateToggle)

    return ToggleFrame
end

-- Add Label
function VintageUI:AddLabel(tab, config)
    config = config or {}
    local text = config.Text or "Label"

    local LabelFrame = Create("Frame", {
        Name = text .. "Label",
        Parent = tab.Content,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -4, 0, 20),
    })

    local LabelText = Create("TextLabel", {
        Name = "Text",
        Parent = LabelFrame,
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Colors.ElementText,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        Size = UDim2.new(1, 0, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    return LabelFrame
end

-- Notification System
function VintageUI:Notify(config)
    config = config or {}
    local text = config.Text or "Notification"
    local duration = config.Duration or 3

    local NotifFrame = Create("Frame", {
        Name = "Notification",
        Parent = self.ScreenGui,
        BackgroundColor3 = Colors.Background,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 250, 0, 40),
        Position = UDim2.new(0, -260, 1, -50),
    })

    local NotifCorner = Create("UICorner", {
        CornerRadius = UDim.new(0, 4),
        Parent = NotifFrame,
    })

    local NotifStroke = Create("UIStroke", {
        Color = Colors.Border,
        Thickness = 1,
        Parent = NotifFrame,
    })

    local NotifText = Create("TextLabel", {
        Name = "Text",
        Parent = NotifFrame,
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Colors.ElementText,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 5, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    Tween(NotifFrame, {Position = UDim2.new(0, 10, 1, -50)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    task.delay(duration, function()
        Tween(NotifFrame, {Position = UDim2.new(0, -260, 1, -50)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.delay(0.5, function()
            NotifFrame:Destroy()
        end)
    end)
end

return VintageUI
