-- ============================================
-- TOGGLE VISIBILITY
-- ============================================
function VintageUI:Toggle()
    if self.IsAnimating then return end
    self.IsAnimating = true
    self.IsVisible = not self.IsVisible

    if self.IsVisible then
        self.MainFrame.Visible = true
        DiagonalSliceAnimation(self.MainFrame, "in", function()
            self.IsAnimating = false
        end)
    else
        DiagonalSliceAnimation(self.MainFrame, "out", function()
            self.MainFrame.Visible = false
            self.IsAnimating = false
        end)
    end
end

-- ============================================
-- CREATE TAB
-- ============================================
function VintageUI:CreateTab(name)
    local tab = {}
    tab.Name = name

    local TabButton = Create("TextButton", {
        Name = name .. "Tab", Parent = self.TabContainer,
        BackgroundColor3 = Colors.TabBg, BorderSizePixel = 0,
        Text = "", Size = UDim2.new(1, -4, 0, 26), AutoButtonColor = false,
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = TabButton})

    local TabIcon = Create("Frame", {Name = "Icon", Parent = TabButton, BackgroundColor3 = Colors.White, BorderSizePixel = 0, Size = UDim2.new(0, 7, 0, 7), Position = UDim2.new(0, 6, 0.5, -3)})
    Create("UICorner", {CornerRadius = UDim.new(0, 1), Parent = TabIcon})

    local TabLabel = Create("TextLabel", {
        Name = "Label", Parent = TabButton, BackgroundTransparency = 1,
        Text = name, TextColor3 = Colors.TabText, TextSize = 11,
        Font = Enum.Font.Gotham, Size = UDim2.new(1, -18, 1, 0),
        Position = UDim2.new(0, 16, 0, 0), TextXAlignment = Enum.TextXAlignment.Left,
    })

    local TabContent = Create("Frame", {
        Name = name .. "Content", Parent = self.ElementContainer,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Visible = false,
    })
    Create("UIListLayout", {Parent = TabContent, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder})

    tab.Button = TabButton
    tab.Content = TabContent
    tab.Icon = TabIcon
    tab.Label = TabLabel

    TabButton.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

    TabButton.MouseEnter:Connect(function()
        if self.CurrentTab ~= tab then
            Tween(TabButton, {BackgroundColor3 = Colors.TabActive}, 0.2)
            Tween(TabLabel, {TextColor3 = Colors.TabTextActive}, 0.2)
        end
    end)

    TabButton.MouseLeave:Connect(function()
        if self.CurrentTab ~= tab then
            Tween(TabButton, {BackgroundColor3 = Colors.TabBg}, 0.2)
            Tween(TabLabel, {TextColor3 = Colors.TabText}, 0.2)
        end
    end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then self:SelectTab(tab) end

    return tab
end

-- ============================================
-- SELECT TAB
-- ============================================
function VintageUI:SelectTab(tab)
    if self.CurrentTab == tab then return end

    if self.CurrentTab then
        self.CurrentTab.Content.Visible = false
        Tween(self.CurrentTab.Button, {BackgroundColor3 = Colors.TabBg}, 0.25)
        Tween(self.CurrentTab.Label, {TextColor3 = Colors.TabText}, 0.25)
        Tween(self.CurrentTab.Icon, {BackgroundTransparency = 1}, 0.25)
    end

    self.CurrentTab = tab
    tab.Content.Visible = true
    Tween(tab.Button, {BackgroundColor3 = Colors.TabActive}, 0.25)
    Tween(tab.Label, {TextColor3 = Colors.TabTextActive}, 0.25)
    Tween(tab.Icon, {BackgroundTransparency = 0}, 0.25)

    self.TabTitle.Text = tab.Name
end

