        Size = UDim2.new(0.3, 0, 0, 16),
        Position = UDim2.new(0, 20, 0, 2),
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Value Label
    local ValueLabel = Create("TextLabel", {
        Name = "Value",
        Parent = SliderFrame,
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = Colors.ElementText,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        Size = UDim2.new(0, 30, 0, 16),
        Position = UDim2.new(1, -35, 0, 2),
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    -- Track Background
    local TrackBg = Create("Frame", {
        Name = "TrackBg",
        Parent = SliderFrame,
        BackgroundColor3 = Colors.SliderTrack,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -16, 0, 6),
        Position = UDim2.new(0, 8, 0, 22),
    })

    local TrackBgCorner = Create("UICorner", {
        CornerRadius = UDim.new(0, 3),
        Parent = TrackBg,
    })

    -- Track Fill
    local TrackFill = Create("Frame", {
        Name = "TrackFill",
        Parent = TrackBg,
        BackgroundColor3 = Colors.SliderFill,
        BorderSizePixel = 0,
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
    })

    local TrackFillCorner = Create("UICorner", {
        CornerRadius = UDim.new(0, 3),
        Parent = TrackFill,
    })

    -- Handle
    local Handle = Create("Frame", {
        Name = "Handle",
        Parent = TrackBg,
        BackgroundColor3 = Colors.SliderFill,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new((default - min) / (max - min), -5, 0.5, -5),
    })

    local HandleCorner = Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = Handle,
    })

    -- Interaction
    local dragging = false
    local SliderButton = Create("TextButton", {
        Name = "SliderButton",
        Parent = SliderFrame,
        BackgroundTransparency = 1,
        Text = "",
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0, 14),
    })

    local function UpdateSlider(input)
        local pos = math.clamp((input.Position.X - TrackBg.AbsolutePosition.X) / TrackBg.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (pos * (max - min)))

        TrackFill.Size = UDim2.new(pos, 0, 1, 0)
        Handle.Position = UDim2.new(pos, -5, 0.5, -5)
        ValueLabel.Text = tostring(value)

        callback(value)
    end

    SliderButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateSlider(input)
        end
    end)

    SliderButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)

    -- Hover effect
    SliderFrame.MouseEnter:Connect(function()
        Tween(SliderFrame, {BackgroundColor3 = Colors.ElementHover}, 0.15)
    end)

    SliderFrame.MouseLeave:Connect(function()
        Tween(SliderFrame, {BackgroundColor3 = Colors.ElementBg}, 0.15)
    end)

    return SliderFrame
end

