function VintageUI:CreateTab(name)
    local tab = {}
    tab.Name = name
    tab.Elements = {}

    -- Tab Button
    local TabButton = Create("TextButton", {
        Name = name .. "Tab",
        Parent = self.TabContainer,
        BackgroundColor3 = Colors.TabBackground,
