        Parent = TabButton,
    })

    -- Tab Icon (small square)
    local TabIcon = Create("Frame", {
        Name = "Icon",
        Parent = TabButton,
        BackgroundColor3 = Colors.White,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 8, 0, 8),
        Position = UDim2.new(0, 6, 0.5, -4),
    })

    local TabIconCorner = Create("UICorner", {
        CornerRadius = UDim.new(0, 1),
        Parent = TabIcon,
    })

    -- Tab Label
    local TabLabel = Create("TextLabel", {
        Name = "Label",
        Parent = TabButton,
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Colors.TabText,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 18, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Tab Content Frame (holds elements)
    local TabContent = Create("Frame", {
        Name = name .. "Content",
        Parent = self.ElementContainer,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Visible = false,
    })

    local ContentListLayout = Create("UIListLayout", {
        Parent = TabContent,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    tab.Button = TabButton
    tab.Content = TabContent
    tab.Icon = TabIcon

    -- Tab click handler
    TabButton.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    TabButton.MouseEnter:Connect(function()
        if self.CurrentTab ~= tab then
            Tween(TabButton, {BackgroundColor3 = Colors.TabActive}, 0.15)
        end
    end)

    TabButton.MouseLeave:Connect(function()
        if self.CurrentTab ~= tab then
            Tween(TabButton, {BackgroundColor3 = Colors.TabBackground}, 0.15)
        end
    end)

    table.insert(self.Tabs, tab)

    -- Auto-select first tab
    if #self.Tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

-- Select Tab
function VintageUI:SelectTab(tab)
    if self.CurrentTab == tab then return end

    -- Deselect current
    if self.CurrentTab then
        self.CurrentTab.Content.Visible = false
        Tween(self.CurrentTab.Button, {BackgroundColor3 = Colors.TabBackground}, 0.2)
        Tween(self.CurrentTab.Icon, {BackgroundColor3 = Colors.White}, 0.2)
    end

    -- Select new
    self.CurrentTab = tab
    tab.Content.Visible = true
    Tween(tab.Button, {BackgroundColor3 = Colors.TabActive}, 0.2)
    Tween(tab.Icon, {BackgroundColor3 = Colors.White}, 0.2)

    -- Update title
    self.TabTitle.Text = tab.Name
end

