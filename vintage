-- ============================================
-- ADD SLIDER (with smooth handle animation)
-- ============================================
function VintageUI:AddSlider(tab, config)
    config = config or {}
    local text = config.Text or "Slider"
    local min = config.Min or 0
    local max = config.Max or 100
    local default = config.Default or 50
    local callback = config.Callback or function() end

    local SliderFrame = Create("Frame", {
        Name = text .. "Slider", Parent = tab.Content,
        BackgroundColor3 = Colors.ElementBg, BorderSizePixel = 0, Size = UDim2.new(1, -4, 0, 36),
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = SliderFrame})

    local SliderIcon = Create("Frame", {Name = "Icon", Parent = SliderFrame, BackgroundColor3 = Colors.ElementText, BorderSizePixel = 0, Size = UDim2.new(0, 7, 0, 7), Position = UDim2.new(0, 8, 0, 6)})
    Create("UICorner", {CornerRadius = UDim.new(0, 1), Parent = SliderIcon})

    local SliderLabel = Create("TextLabel", {
        Name = "Label", Parent = SliderFrame, BackgroundTransparency = 1,
        Text = text, TextColor3 = Colors.ElementText, TextSize = 11,
        Font = Enum.Font.Gotham, Size = UDim2.new(0.3, 0, 0, 16),
        Position = UDim2.new(0, 18, 0, 2), TextXAlignment = Enum.TextXAlignment.Left,
    })

    local ValueLabel = Create("TextLabel", {
        Name = "Value", Parent = SliderFrame, BackgroundTransparency = 1,
        Text = tostring(default), TextColor3 = Colors.ElementText, TextSize = 10,
        Font = Enum.Font.Gotham, Size = UDim2.new(0, 30, 0, 16),
        Position = UDim2.new(1, -38, 0, 2), TextXAlignment = Enum.TextXAlignment.Right,
    })

    local TrackBg = Create("Frame", {
        Name = "TrackBg", Parent = SliderFrame, BackgroundColor3 = Colors.SliderTrack,
        BorderSizePixel = 0, Size = UDim2.new(1, -16, 0, 6), Position = UDim2.new(0, 8, 0, 22),
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = TrackBg})

    local defaultPercent = (default - min) / (max - min)
    local TrackFill = Create("Frame", {
        Name = "TrackFill", Parent = TrackBg, BackgroundColor3 = Colors.SliderFill,
        BorderSizePixel = 0, Size = UDim2.new(defaultPercent, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0),
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = TrackFill})

    local Handle = Create("Frame", {
        Name = "Handle", Parent = TrackBg, BackgroundColor3 = Colors.SliderHandle,
        BorderSizePixel = 0, Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(defaultPercent, -5, 0.5, -5),
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Handle})

    -- Glow effect
    local HandleGlow = Create("Frame", {
        Name = "Glow", Parent = Handle, BackgroundColor3 = Colors.SliderHandle,
        BackgroundTransparency = 0.7, BorderSizePixel = 0,
        Size = UDim2.new(1, 4, 1, 4), Position = UDim2.new(0, -2, 0, -2),
    })
    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = HandleGlow})

    local SliderButton = Create("TextButton", {
        Name = "SliderButton", Parent = SliderFrame, BackgroundTransparency = 1,
        Text = "", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 14),
        AutoButtonColor = false,
    })

    local dragging = false

    local function UpdateSlider(input, animate)
        local trackAbsPos = TrackBg.AbsolutePosition.X
        local trackAbsSize = TrackBg.AbsoluteSize.X
        local mouseX = input.Position.X

        local pos = math.clamp((mouseX - trackAbsPos) / trackAbsSize, 0, 1)
        local value = math.floor(min + (pos * (max - min)))

        if animate then
            Tween(TrackFill, {Size = UDim2.new(pos, 0, 1, 0)}, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            Tween(Handle, {Position = UDim2.new(pos, -5, 0.5, -5)}, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        else
            TrackFill.Size = UDim2.new(pos, 0, 1, 0)
            Handle.Position = UDim2.new(pos, -5, 0.5, -5)
        end

        ValueLabel.Text = tostring(value)
        callback(value)
        return value
    end

    SliderButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateSlider(input, true)
            Tween(Handle, {Size = UDim2.new(0, 12, 0, 12)}, 0.15)
            Handle.Position = UDim2.new(Handle.Position.X.Scale, -6, 0.5, -6)
        end
    end)

    SliderButton.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            Tween(Handle, {Size = UDim2.new(0, 10, 0, 10)}, 0.15)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input, false)
        end
    end)

    local isSliderHovered = false
    SliderFrame.MouseEnter:Connect(function()
        isSliderHovered = true
        Tween(SliderFrame, {BackgroundColor3 = Colors.ElementHover}, 0.15)
    end)

    SliderFrame.MouseLeave:Connect(function()
        isSliderHovered = false
        if not dragging then
            Tween(SliderFrame, {BackgroundColor3 = Colors.ElementBg}, 0.15)
        end
    end)

    return SliderFrame
end

